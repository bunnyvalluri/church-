# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
test-results/
playwright-report/
frontend/test-results/
frontend/playwright-report/

# next.js
/.next/
/out/
frontend/.next/
frontend/out/

# production
/build
frontend/build/

# Certificates, keys, and private stores
*.pem
*.key
*.crt
*.pfx
*.p12
service-account*.json
credentials*.json
firebase-service-account*.json
*serviceAccount*.json

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment files (Strictly enforce .env.example tracking only)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Vercel output & project cache
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# prisma
/prisma/migrations
backend/prisma/migrations
frontend/prisma/generated/

# local fallbacks
/prisma/fallback_*.json
/prisma/dev.db
/prisma/dev.db-journal
backend/prisma/dev.db
backend/prisma/dev.db-journal

# agent reports
eslint-report*.txt

# scratch files
/scratch/

# large raw media in root folder
/KCM_NGO_SERVICES/
/kcm-gallery/
**/*.avi
**/*.mov
**/*.wmv

# Allow compressed web MP4 files in frontend public directory
!frontend/public/KCM_NGO_SERVICES/
!frontend/public/KCM_NGO_SERVICES/**/*.mp4

# Exclude raw uncompressed camera files exceeding GitHub's 100MB limit
frontend/public/KCM_NGO_SERVICES/**/VID_20260825_120657614.mp4
frontend/public/KCM_NGO_SERVICES/**/VID_20260825_120805292.mp4

# temp/test scripts
frontend/prisma/test-service.js
