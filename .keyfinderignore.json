{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "KCM Church Portal - KeyFinder Security Policy & Exclusions",
  "version": "2.1.0",
  "description": "Comprehensive security policy, exclusions, and classifications for third-party scripts, public client identifiers, browser storage, and benign UI state identified by KeyFinder scans.",
  "rules": [
    {
      "id": "RULE-01-LOCAL-CINEMA-ELK-RESIDUE",
      "targetDomain": "localhost",
      "storageType": "localStorage",
      "pattern": "cinema_elk_*",
      "classification": "FALSE_POSITIVE",
      "rationale": "Residual browser web storage from an external developer workspace project ('Cinema Elk') sharing localhost:3000 origin. Not part of KCM Church codebase or deployments.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-02-LOCAL-RUDDERSTACK-COOKIE",
      "targetDomain": "localhost",
      "storageType": "cookie",
      "pattern": "rl_session*",
      "classification": "FALSE_POSITIVE",
      "rationale": "Residual Rudderstack/analytics telemetry cookie left on localhost:3000 by another application session. KCM Church exclusively uses 'kcm_session' HttpOnly cookie.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-03-NEXTJS-ROUTER-INTERNALS",
      "targetDomain": "localhost",
      "storageType": "external_script",
      "patterns": [
        "__reactLoad$",
        "${pathname}:${searchParamsString}*",
        "/_not-found",
        "tooltip-item-*"
      ],
      "classification": "FALSE_POSITIVE",
      "rationale": "Next.js App Router and React runtime dynamic chunk loader function names and route cache keys incorrectly matched by keyword 'key'.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-04-LOCAL-CLINICAL-AI-RESIDUE",
      "targetDomain": "localhost",
      "storageType": "external_script",
      "patterns": [
        "clinical_ai_refresh_token",
        "eval-doctor-token*",
        "eval-admin-token*",
        "eval-nurse-token*",
        "eval-*-refresh*"
      ],
      "classification": "FALSE_POSITIVE",
      "rationale": "Residual browser cache/service worker token keywords from unrelated local development projects tested in the same browser profile.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-05-GOOGLE-WARMUP-RECAPTCHA",
      "targetDomain": "www.google.com",
      "storageType": "web_storage",
      "patterns": [
        "cb_wlz.*",
        "inline-promo;*",
        "_grecaptcha-*",
        "im;4;vcg0ZMx6Z*"
      ],
      "classification": "FALSE_POSITIVE",
      "rationale": "Standard Google search warmup client state, translation promo cache, and reCAPTCHA challenge tokens managed entirely within Google's origin.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-06-VERCEL-LIVE-TOOLBAR",
      "targetDomain": "vercel.live",
      "storageType": "web_storage",
      "patterns": [
        "vercel-toolbar-*",
        "vercel-feedback-rep-cookie*",
        "vercel-toolbar-experiment-uuid-*"
      ],
      "classification": "FALSE_POSITIVE",
      "rationale": "Vercel preview toolbar infrastructure injection for deployment comments and feature flags. Exists only in development/preview environments and managed by Vercel platform.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-07-YOUTUBE-IFRAME-PLAYER",
      "targetDomain": "www.youtube.com",
      "storageType": "inline_script",
      "patterns": [
        "AIzaSyAO_F3Z5IqL8QTS1bHLSclIw_VR_I1qodE",
        "yt-remote-device-id-*",
        "ytembeds.base.*"
      ],
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "Official YouTube public web player embed API key, player build version tags, and remote device pairing IDs loaded in sandboxed youtube.com iframes for sermon and worship video streaming.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-08-KCM-PUSHER-TRANSPORT-METADATA",
      "targetDomain": "kcmchurch.vercel.app",
      "storageType": "web_storage",
      "pattern": "pusherTransportTLS*",
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "Client-side WebSocket connection transport preference and timestamp cache stored by Pusher JS client for realtime sermon and chat updates.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-09-KCM-BRANCH-SELECTOR",
      "targetDomain": "kcmchurch.vercel.app",
      "storageType": "web_storage",
      "pattern": "kcm-selected-branch*",
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "User's chosen church branch ID (CUID) for filtering local announcements and events (e.g. Shapur, Subhash Nagar, Bahadurpally). Contains zero sensitive data.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-10-FIREBASE-AUTH-ERROR-CODES",
      "targetDomain": "kcmchurch.vercel.app",
      "storageType": "external_script",
      "patterns": [
        "invalid-oauth-client-id",
        "missing-multi-factor-session",
        "invalid-recaptcha-token",
        "missing-recaptcha-token",
        "invalid-user-token",
        "invalid-credential",
        "internal-error",
        "missing-password",
        "wrong-password",
        "auth/invalid-api-key",
        "auth/invalid-oauth-client-id",
        "auth/rejected-credential"
      ],
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "Firebase Authentication SDK public error code dictionary strings bundled for client-side exception handling, matched by keyword rules 'client_id', 'credential', and 'password'.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-11-I18N-UI-TRANSLATION-STRINGS",
      "targetDomain": "kcmchurch.vercel.app",
      "storageType": "external_script",
      "patterns": [
        "Razorpay కీ ID",
        "Razorpay कुंजी ID",
        "Razorpay Key ID",
        "API कुंजी",
        "పాస్‌వర్డ్",
        "పాస్‌వర్డ్ నిర్ధారించండి",
        "పాస్‌వర్డ్ మర్చిపోయారా?",
        "పాస్‌వర్డ్ చాలా బలహీనంగా ఉంది*",
        "తప్పు పాస్‌వర్డ్*",
        "पासवर्ड",
        "पासवर्ड भूल गए?",
        "पासवर्ड बहुत कमजोर है*",
        "पासवर्ड की पुष्टि करें"
      ],
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "Multilingual UI text strings (Telugu/Hindi/English) translating forms, field labels, and validation error messages for passwords and donation gateway keys.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-12-KCM-THEME-STORAGE-KEY",
      "targetDomain": "kcmchurch.vercel.app",
      "storageType": "web_storage",
      "pattern": "kcm-theme",
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "UI dark/light mode preference storage key used by next-themes provider. Stores only 'light', 'dark', or 'system'.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-13-GOOGLE-OGS-ONEGOOGLE-WIDGET",
      "targetDomain": "ogs.google.com",
      "storageType": "external_script",
      "patterns": [
        "https://www.gstatic.com/_/mss/boq-one-g*",
        "boq-one-google.OneGoogleWidget&*"
      ],
      "classification": "FALSE_POSITIVE",
      "rationale": "Google Account switcher and OneGoogle widget assets loaded when users interact with Google Identity Services.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-14-EXTERNAL-DEV-PORTFOLIO-COOKIE",
      "targetDomain": "valluri-rahul-portfolio.vercel.app",
      "storageType": "cookie",
      "pattern": "_vercel_session*",
      "classification": "FALSE_POSITIVE",
      "rationale": "Vercel deployment session cookie on an external developer portfolio site visited in the same browser profile.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-15-FIREBASE-PUBLIC-WEB-API-KEY",
      "targetDomain": "kcmchurch.vercel.app",
      "storageType": "external_script",
      "patterns": [
        "AIzaSyBaNc9dgk4StKQsY2L73d2H4Hk_QnwAzN0"
      ],
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "Google Firebase Web Client API key (NEXT_PUBLIC_FIREBASE_API_KEY) designed specifically for client-side app initialization and protected by Firebase Security Rules and domain restrictions.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-16-GOOGLE-OAUTH-CLIENT-ID",
      "targetDomain": "kcmchurch.vercel.app",
      "storageType": "external_script",
      "patterns": [
        "410280994688-ln5134fjt46akdl9m781rc74fu40hq44.apps.googleusercontent.com"
      ],
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "Public Google OAuth 2.0 Client ID used for client-side 'Sign in with Google' workflow. Designed to be public by OAuth 2.0 RFC specifications.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-17-KCM-OPTIMISTIC-IMAGE-CACHE",
      "targetDomain": "kcmchurch.vercel.app",
      "storageType": "web_storage",
      "pattern": "kcm_deleted_images*",
      "classification": "PUBLIC_CONFIGURATION",
      "rationale": "Browser local storage key holding temporary array of deleted image paths for optimistic UI removal in gallery management.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-18-GOOGLE-IDENTITY-SERVICES-ORIGINS",
      "targetDomain": "accounts.google.com",
      "storageType": "web_storage",
      "patterns": [
        "kc.*",
        "sessionPrivateKey*",
        "data-credential-response*",
        "boq-identity.*"
      ],
      "classification": "FALSE_POSITIVE",
      "rationale": "Google Account login and consent UI internal crypto tokens, session state, and DOM attributes loaded in sandboxed Google authentication iframe/popup.",
      "action": "EXCLUDE_FROM_SCAN"
    },
    {
      "id": "RULE-19-THIRD-PARTY-ADMIN-AND-DEV-TOOLS",
      "targetDomain": "*",
      "storageType": "external_script",
      "patterns": [
        "console.neon.tech*",
        "dashboard.render.com*",
        "search.google.com*",
        "business.google.com*",
        "formspark.io*",
        "github.com*",
        "studio.youtube.com*",
        "ilovepdf.com*",
        "safeframe.googlesyndication.com*"
      ],
      "classification": "FALSE_POSITIVE",
      "rationale": "Third-party browser tabs and management dashboards open during browser automated recording. Isolated from KCM application bundle.",
      "action": "EXCLUDE_FROM_SCAN"
    }
  ]
}
