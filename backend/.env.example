# ──────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES TEMPLATE (Kingdom of Christ Ministries Backend)
# Rename this file to `.env` or set these in your deployment dashboard.
# DO NOT commit real secrets or credentials to git version control!
# ──────────────────────────────────────────────────────────────────────────────

# ── 1. Server & Process Runtime ──────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
SOCKET_PORT="3001"
PROCESS_TYPE="all" # Options: all | api | socket | worker

# ── 2. Database Configuration (Prisma & Neon PostgreSQL & MongoDB) ───────────
# Primary PostgreSQL source of truth (Neon / Supabase / RDS)
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@localhost:5432/church_db?schema=public"
# If true, queries degrade gracefully with mock fixtures when DB is unreachable
DB_OFFLINE="true"

# MongoDB Atlas (Audit logs & high-throughput sync batches)
MONGODB_URI="mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/<DATABASE>?retryWrites=true&w=majority"
MONGODB_DATABASE_NAME="kcm_church"
MONGODB_OFFLINE="true"

# ── 3. Redis & BullMQ Background Queues ──────────────────────────────────────
# Redis connection string (Supports redis://, rediss:// for Upstash TLS)
REDIS_URL="redis://127.0.0.1:6379"
# Set to true to disable background workers in memory-constrained environments
DISABLE_BULLMQ="false"

# ── 4. Authentication, Sessions & Security ───────────────────────────────────
# Secret key used for signing session cookies, JWTs, and CSRF state
SESSION_SECRET="kcm-church-portal-secure-session-auth-key-2026"
NEXTAUTH_SECRET="your-32-character-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google Identity Services (GIS) Verification
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ── 5. Firebase Admin & FCM Push Notifications ───────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:a1b2c3d4e5f6g7h8i9"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-MEASUREMENT"

# Firebase Admin SDK (JSON string or Base64 encoded serviceAccount.json)
FIREBASE_PROJECT_ID="your-app-id"
FIREBASE_ADMIN_SERVICE_ACCOUNT=""
FIRESTORE_OFFLINE="true"

# ── 6. Payment Gateways (Razorpay & Stripe) ──────────────────────────────────
# Razorpay (India INR Payments & Webhook Verification)
RAZORPAY_KEY_ID="rzp_test_yourKeyHere"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyHere"
RAZORPAY_KEY_SECRET="yourSecretHere"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecretHere"

# Stripe (Optional International Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_yourKeyHere"
STRIPE_SECRET_KEY="sk_test_yourSecretHere"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# ── 7. Cloudinary Media Storage ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ── 8. External Communications (SMS & Email) ──────────────────────────────────
# httpSMS Android Gateway Engine
SMS_PROVIDER="httpsms" # Options: httpsms | mock
HTTPSMS_API_KEY="your_httpsms_api_key_here"
HTTPSMS_FROM_NUMBER="+919876543210"
HTTPSMS_BASE_URL="https://api.httpsms.com/v1"
HTTPSMS_WEBHOOK_SECRET="your_webhook_signing_secret"
SMS_DEFAULT_COUNTRY="IN"
SMS_MAX_RETRIES="3"
SMS_RATE_LIMIT_PER_MINUTE="30"
SMS_QUEUE_ENABLED="true"

# Resend Transactional Email API
RESEND_API_KEY="re_yourResendKeyHere"
CHURCH_NOTIFICATION_EMAIL="notifications@kcmchurch.org"

# Twilio SMS API (Optional Backup)
TWILIO_ACCOUNT_SID="ACyourAccountSidHere"
TWILIO_AUTH_TOKEN="yourAuthTokenHere"
TWILIO_FROM_NUMBER="+1234567890"

# ── 9. Church Branding & Metadata ─────────────────────────────────────────────
NEXT_PUBLIC_CHURCH_NAME="Kingdom of Christ Ministries"
NEXT_PUBLIC_CHURCH_ADDRESS="15-201, Vivekananda Nagar, Srinivas Nagar, Jeedimetla, Hyderabad, Telangana 500055"
NEXT_PUBLIC_CHURCH_PHONE="+91 97040 90069"
NEXT_PUBLIC_CHURCH_EMAIL="kingofchristministries23@gmail.com"
