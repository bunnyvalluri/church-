{
  "openapi": "3.0.3",
  "info": {
    "title": "Kingdom of Christ Ministries (KCM Church) Backend API",
    "version": "3.0.0-ENTERPRISE",
    "description": "Production-ready, zero-trust backend REST and real-time API for KCM Church. Supports GIS authentication, RBAC, branch isolation, donations, event attendance, and offline sync."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.kcmchurch.org",
      "description": "Production API Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kcm_session"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object", "nullable": true },
          "message": { "type": "string" },
          "correlationId": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "message", "correlationId", "timestamp"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "UNAUTHORIZED" },
              "message": { "type": "string", "example": "Authentication token missing or invalid" }
            }
          },
          "correlationId": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 }
        }
      },
      "GoogleAuthRequest": {
        "type": "object",
        "required": ["credential"],
        "properties": {
          "credential": { "type": "string", "description": "Google Identity Services ID Token" }
        }
      },
      "DonationCreateRequest": {
        "type": "object",
        "required": ["amount", "purpose"],
        "properties": {
          "amount": { "type": "number", "minimum": 1, "description": "Donation amount in INR" },
          "purpose": { "type": "string", "enum": ["TITHE", "OFFERING", "BUILDING_FUND", "MISSIONS", "GENERAL"] },
          "donorName": { "type": "string" },
          "donorEmail": { "type": "string", "format": "email" },
          "donorPhone": { "type": "string" },
          "idempotencyKey": { "type": "string", "description": "UUID or unique string for deduplication" }
        }
      },
      "OfflineSyncRequest": {
        "type": "object",
        "required": ["mutations"],
        "properties": {
          "clientId": { "type": "string" },
          "mutations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["entity", "action", "data", "clientVersion"],
              "properties": {
                "entity": { "type": "string", "enum": ["ATTENDANCE", "PRAYER", "NOTE", "PROFILE"] },
                "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE"] },
                "data": { "type": "object" },
                "clientVersion": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Container Liveness Probe",
        "responses": {
          "200": { "description": "Application process is live" }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Container Readiness Probe",
        "responses": {
          "200": { "description": "Database and dependencies connected" },
          "503": { "description": "Dependencies unavailable" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate with email & password",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Authentication successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "summary": "Verify Google GIS Credential Token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GoogleAuthRequest" } } }
        },
        "responses": {
          "200": { "description": "Google auth verified and session issued" },
          "401": { "description": "Invalid Google token" }
        }
      }
    },
    "/api/donations/create-order": {
      "post": {
        "summary": "Create Razorpay payment order with idempotency protection",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DonationCreateRequest" } } }
        },
        "responses": {
          "200": { "description": "Order created successfully" },
          "400": { "description": "Validation error or invalid amount" }
        }
      }
    },
    "/api/offline-sync/push": {
      "post": {
        "summary": "Process offline mutation batches with optimistic concurrency checking",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OfflineSyncRequest" } } }
        },
        "responses": {
          "200": { "description": "Offline mutations processed and synced" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/webhooks/razorpay": {
      "post": {
        "summary": "Razorpay payment webhook receiver with HMAC-SHA256 signature verification",
        "parameters": [
          { "in": "header", "name": "x-razorpay-signature", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Webhook received and processed idempotently" },
          "400": { "description": "Invalid signature or malformed payload" }
        }
      }
    }
  }
}

