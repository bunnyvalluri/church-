{
  "python.terminal.useEnvFile": true,
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "files.associations": {
    ".env*": "properties"
  },
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "docker.lsp.experimental.vulnerabilityScanning": false,
  "docker.lsp.experimental.scout.criticalHighVulnerabilities": false,
  "docker.lsp.experimental.scout.vulnerabilities": false,
  "docker.lsp.experimental.scout.recommendedTag": false,
  "docker.lsp.experimental.scout.notPinnedDigest": false,
  "yaml.customTags": [
    "!Ref",
    "!Sub",
    "!GetAtt",
    "!FindInMap",
    "!Equals",
    "!Not",
    "!And",
    "!Or",
    "!If"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  }
}
