{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "PostgreSQL Slow Queries (>200ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (pod) (rate({category=\"DATABASE\"} | json | database_is_slow=\"true\" [$__interval]))",
          "legendFormat": "{{pod}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "title": "CloudNativePG Error Logs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (container) (rate({app=\"cnpg-operator\"} |~ \"(?i)error|fatal\" [$__interval]))",
          "legendFormat": "{{container}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Database Logs Stream",
      "type": "logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 8 },
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showTime": true
      },
      "targets": [
        {
          "expr": "{category=\"DATABASE\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["logging", "loki", "kcm", "database", "cnpg", "postgres"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "KCM Platform - Database Logs (CloudNativePG)",
  "uid": "kcm-database-logs"
}
