{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "Envoy Gateway HTTP Status Codes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status_code) (rate({namespace=\"envoy-gateway-system\"} | json [$__interval]))",
          "legendFormat": "HTTP {{status_code}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Envoy Ingress Traffic Volume (Lines/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate({namespace=\"envoy-gateway-system\"}[$__interval]))",
          "legendFormat": "Requests / sec",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Envoy Gateway Access Log Explorer",
      "type": "logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 8 },
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showTime": true
      },
      "targets": [
        {
          "expr": "{namespace=\"envoy-gateway-system\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["logging", "loki", "kcm", "gateway", "envoy"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "KCM Platform - Gateway & Ingress Logs",
  "uid": "kcm-gateway-logs"
}
