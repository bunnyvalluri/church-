{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Log Rate by Namespace",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (namespace) (rate({namespace=~\".+\"}[$__interval]))",
          "legendFormat": "{{namespace}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Log Volume by Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (container) (rate({namespace=~\".+\"} |~ \"(?i)error|fatal|exception\"[$__interval]))",
          "legendFormat": "{{container}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cluster Log Viewer",
      "type": "logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 8 },
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showTime": true
      },
      "targets": [
        {
          "expr": "{namespace=~\".+\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["logging", "loki", "kcm", "cluster"],
