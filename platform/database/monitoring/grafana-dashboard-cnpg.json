{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Cluster Status",
      "type": "stat",
      "targets": [
        {
          "expr": "cnpg_pg_replication_is_replica{cluster=\"kcm-db-cluster\"}",
          "legendFormat": "{{pod}} (Replica: {{value}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Active Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(cnpg_pg_stat_database_numbackends{cluster=\"kcm-db-cluster\"})",
          "legendFormat": "Active Connections"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Max Replication Lag (Seconds)",
      "type": "stat",
      "targets": [
        {
          "expr": "max(cnpg_pg_replication_lag_seconds{cluster=\"kcm-db-cluster\"})",
          "legendFormat": "Lag (s)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Last Backup Status",
      "type": "stat",
      "targets": [
        {
          "expr": "cnpg_backup_last_status{cluster=\"kcm-db-cluster\"}",
          "legendFormat": "Backup Success Status (1=OK)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Transactions Committed & Rolled Back",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(cnpg_pg_stat_database_xact_commit{cluster=\"kcm-db-cluster\"}[1m])",
          "legendFormat": "Commits/sec"
        },
        {
          "expr": "rate(cnpg_pg_stat_database_xact_rollback{cluster=\"kcm-db-cluster\"}[1m])",
          "legendFormat": "Rollbacks/sec"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Replication Byte Lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "cnpg_pg_replication_lag_bytes{cluster=\"kcm-db-cluster\"}",
          "legendFormat": "{{pod}} byte lag"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "CPU & Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{namespace=\"kcm-database\"}) by (pod)",
          "legendFormat": "CPU (cores) {{pod}}"
        },
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"kcm-database\"}) by (pod)",
          "legendFormat": "Memory {{pod}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Database Disk Volume Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"kcm-database\"}",
          "legendFormat": "Used {{persistentvolumeclaim}}"
        },
        {
          "expr": "kubelet_volume_stats_capacity_bytes{namespace=\"kcm-database\"}",
          "legendFormat": "Capacity {{persistentvolumeclaim}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cnpg", "postgresql", "kcm"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "title": "CloudNativePG PostgreSQL Enterprise Dashboard",
  "uid": "cnpg-enterprise-kcm"
}
