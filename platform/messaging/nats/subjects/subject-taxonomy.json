    "sms": {
      "prefix": "sms.jobs",
      "subjects": [
        "sms.jobs.alert.send",
        "sms.jobs.otp.send",
        "sms.jobs.reminder.send"
      ]
    },
    "push": {
      "prefix": "push.notifications",
      "subjects": [
        "push.notifications.mobile.broadcast",
        "push.notifications.direct.send"
      ]
    },
    "audit": {
      "prefix": "audit.logs",
      "subjects": [
        "audit.logs.access.granted",
        "audit.logs.access.denied",
        "audit.logs.security.violation",
        "audit.logs.data.export"
      ]
    }
