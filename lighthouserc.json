{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run start -w frontend",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/ngo",
        "http://localhost:3000/ngo/projects",
        "http://localhost:3000/ngo/gallery",
        "http://localhost:3000/ngo/videos",
        "http://localhost:3000/ngo/volunteers",
        "http://localhost:3000/ngo/donations",
        "http://localhost:3000/gallery",
        "http://localhost:3000/about/story",
        "http://localhost:3000/about/leadership",
        "http://localhost:3000/about/beliefs",
        "http://localhost:3000/about/ministries",
        "http://localhost:3000/about/mission",
        "http://localhost:3000/sermons",
        "http://localhost:3000/events",
        "http://localhost:3000/prayer",
        "http://localhost:3000/get-involved/small-groups",
        "http://localhost:3000/get-involved/volunteer",
        "http://localhost:3000/membership",
        "http://localhost:3000/locations",
        "http://localhost:3000/contact",
        "http://localhost:3000/login",
        "http://localhost:3000/register"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.90 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "max-potential-fid": ["warn", { "maxNumericValue": 130 }],
        "interactive": ["warn", { "maxNumericValue": 3500 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    }
  }
}
